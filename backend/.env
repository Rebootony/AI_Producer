# —— 大模型配置（OpenAI 兼容；当前使用 OpenRouter 免费模型）——
# 1) 去 https://openrouter.ai → Keys 申请一个免费 API Key
# 2) 把它粘到下面 OPENROUTER_API_KEY 后面（替换占位符），保存
# 3) 重新运行 start_mac.command（或重启后端）即可
LLM_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=<替换>
# 免费且支持工具调用(传话/function calling需要)的模型；也可换其它 :free 模型，或试图片里的 openrouter/free
LLM_MODEL=openai/gpt-oss-120b:free
LLM_SUPPORTS_FUNCTIONS=true
# OpenRouter 排行用，可选
OPENROUTER_SITE_URL=http://localhost:5173
OPENROUTER_APP_NAME=AI Producer

# —— 备选：硅基流动（如需切回，把上面 LLM_BASE_URL/LLM_MODEL 注释掉，启用下面两行）——
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen3-8B
SILICONFLOW_API_KEY=sk-wiyoxkywwtxnwexotwdteyhsbdefeepkflaqvhqozewgkfvl
